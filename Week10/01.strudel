setcps(130/60/5)

$: n("3 6 8 4 6 ~ 6 4 8 6").sound("gm_pan_flute").scale("c:major").gain(0.2).every(4, x => x.fast(2)).degradeBy(0.6)
$: n("6 4 2 8 6 ~ 8 2 6 4").sound("gm_synth_brass_2").scale("c:major").gain(0.2).every(2, x => x.fast(2)).degradeBy(0.4)
$: n("9 3 6 9 ~ 5 2 6 9 6"). sound("gm_alto_sax").scale("c:major").gain(0.2).every(2, x => x.fast(2)).degradeBy(0.2)
$: n("6 4 8 2 ~ 9 6 8 4 8").sound("gm_reed_organ").scale("c:major").gain(0.3).every(2, x => x.fast(2)).degradeBy(0.2)